# Copy this file to secrets.yaml and fill in real values:
#
#     cp secrets.yaml.example secrets.yaml
#
# secrets.yaml holds credentials — keep it out of version control.

wifi_ssid: "YourNetwork"
wifi_password: "your-wifi-password"

# Password for the fallback access point the device raises when it cannot join
# the network above. Replaces airRohr's config AP (which defaulted to
# "airrohrcfg"). Minimum 8 characters.
ap_password: "airrohrcfg"

# Password for OTA updates from ESPHome.
ota_password: "choose-an-ota-password"

# 32-byte base64 key for the Home Assistant API. Generate one with:
#     openssl rand -base64 32
# or use the generator at https://esphome.io/components/api.html
api_encryption_key: "REPLACE_WITH_A_GENERATED_32_BYTE_BASE64_KEY"
